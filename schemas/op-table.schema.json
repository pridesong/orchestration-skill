{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "op-table.schema.json",
  "title": "Operation Table",
  "description": "原语层：操作原语表，条件驱动。回答'怎么做'。",
  "type": "object",
  "required": ["operations"],
  "properties": {
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "condition", "action", "verify"],
        "properties": {
          "id": { "type": "string", "pattern": "^op-" },
          "name": { "type": "string", "minLength": 1 },
          "category": {
            "enum": ["query", "generate", "verify", "audit", "materialize", "transform", "custom"]
          },
          "condition": { "type": "string", "description": "触发条件：何时使用此操作" },
          "action": { "type": "string", "description": "执行动作描述" },
          "verify": { "type": "string", "description": "此操作自身的验证方式" }
        }
      }
    }
  }
}
