{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "steps.schema.json",
  "title": "Assembly Table",
  "description": "装配表：编排者产出。每行 = 一个字段（generate_N 或 discriminate_N_xxx）+ 选中的模块 + 输入连线 + 判别路由。状态机/协议/依赖全部由字段名 + 模块属性推导，编排者只做装配。",
  "type": "object",
  "required": ["task_id", "version", "fields"],
  "properties": {
    "task_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string" },
    "created_at": { "type": "string" },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["field", "module"],
        "properties": {
          "field": {
            "type": "string",
            "pattern": "^(generate_[0-9]+|discriminate_[0-9]+_[a-z][a-z0-9_]*)$",
            "description": "字段名即状态语义：generate_N=生成式产出（落盘即推进）；discriminate_N_xxx=判别式判断项（值决定路由，尾字节定义判断项）"
          },
          "next": {
            "type": "string",
            "description": "generate 字段的显式推进目标（串行）：本字段完成后 → next。op-table 据此生成规则，executor 零推导。"
          },
          "parallel": {
            "type": "array",
            "items": { "type": "string", "pattern": "^generate_[0-9]+$" },
            "description": "并行组声明（generate 字段）：组内字段写在同一行（state.csv 同行填充），全部完成（op-table 多条件 AND）→ next。组内每个字段都声明同一 parallel 数组。"
          },
          "name": { "type": "string", "minLength": 1 },
          "module": { "type": "string", "pattern": "^mod-" },
          "inputs": {
            "type": "object",
            "description": "输入连线：{参数名: 来源}。来源为 artifacts/ 相对路径或前序字段名（generate_01 等）；依赖由此机械推导"
          },
          "routing": {
            "type": "object",
            "description": "仅 discriminate：判别点路由设计——判断值 → 目标（字符串=目标字段/stop；对象=审计回退机制）。编排者设计每个判别点怎么路由，第三步据此生成 op-table。",
            "additionalProperties": {
              "oneOf": [
                { "type": "string", "description": "目标字段名或 stop" },
                {
                  "type": "object",
                  "description": "审计回退机制：to=回退目标；limit=回退次数上限；escalate=超限后换脑去向（mind-decider/mind-choose 等）；mind=本路由的思维覆盖",
                  "properties": {
                    "to": { "type": "string" },
                    "counter": { "type": "string", "description": "回退计数键名（默认 <field>_count，主 agent 上下文管理）" },
                    "limit": { "type": "integer", "minimum": 1 },
                    "escalate": { "type": "string" },
                    "mind": { "type": "string" }
                  },
                  "required": ["to"]
                }
              ]
            }
          },
          "mind_ref": { "type": "string", "pattern": "^mind-", "description": "覆盖模块默认 mind" },
          "forbidden": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "description": "命题级 forbidden：覆盖/补充模块与 mind 的禁令"
          },
          "acceptance_criteria": {
            "type": "array",
            "items": { "type": "string" },
            "description": "验收标准（追加到模块 verify 之后）"
          },
          "status": {
            "enum": ["pending", "running", "passed", "failed", "skipped", "needs_reorchestration"]
          },
          "runtime": {
            "type": "object",
            "description": "运行期字段（执行器写入，编排者不预填）",
            "properties": {
              "failures": { "type": "integer", "minimum": 0 },
              "failure_log": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "at": { "type": "string" },
                    "reason": { "type": "string" },
                    "class": { "enum": ["artifact_missing", "field_missing", "acceptance_failed", "prerequisite", "routing_invalid", "unknown"] }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
