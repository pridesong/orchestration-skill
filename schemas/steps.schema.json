{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "steps.schema.json",
  "title": "Steps",
  "description": "状态层：步骤序列定义。回答'做什么'。",
  "type": "object",
  "required": ["task_id", "version", "steps"],
  "properties": {
    "task_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string" },
    "created_at": { "type": "string" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "output", "depends_on", "op_ref", "acceptance_criteria", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^s[0-9]{3}$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "input": {
            "type": "object",
            "description": "步骤输入：字段引用前序步骤产物（如 {\"from\": \"s001\"}）或任务级参数"
          },
          "output": {
            "type": "object",
            "required": ["file"],
            "properties": {
              "file": { "type": "string", "description": "产物相对路径，位于任务文件夹内" },
              "schema": {
                "type": "object",
                "description": "产物结构要求（JSON 产物时提供 required 字段列表，供 compare.py 检查）",
                "properties": {
                  "required": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          },
          "depends_on": {
            "type": "array",
            "items": { "type": "string", "pattern": "^s[0-9]{3}$" },
            "description": "前置步骤 id 列表，空数组表示无依赖"
          },
          "op_ref": { "type": "string", "pattern": "^op-" },
          "mind_ref": { "type": "string", "pattern": "^mind-" },
          "extra_skills": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "description": "能力插槽（skill）步级补充：本步骤额外需要的 skill（与 op.required_skills 合并，去重）。空数组或缺失 = 无补充。"
          },
          "extra_mcp": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "description": "能力插槽（MCP）步级补充：本步骤额外需要的 MCP 工具/服务（与 op.required_mcp 合并，去重）。空数组或缺失 = 无补充。"
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "description": "验收标准，每条必须可机械检查"
          },
          "status": {
            "enum": ["pending", "running", "passed", "failed", "skipped", "needs_reorchestration"]
          },
          "runtime": {
            "type": "object",
            "description": "运行期字段（执行器写入，编排者不预填）",
            "properties": {
              "failures": { "type": "integer", "minimum": 0 },
              "failure_log": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "at": { "type": "string" },
                    "reason": { "type": "string" },
                    "class": { "enum": ["artifact_missing", "field_missing", "acceptance_failed", "prerequisite", "unknown"] }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
