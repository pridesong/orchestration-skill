      "name": "检索 discussions 反复需求",
      "module": "mod-query",
      "inputs": {
        "repo": "deepseek-ai/deepseek-harness",
        "keywords": [
          "memory",
          "插件市场",
          "subagent"
        ],
        "tool": "gh api graphql"
      },
      "acceptance_criteria": [
        "topics 数组非空",
        "topics 数组长度 >= 3",
        "每条 topic 含 keyword 与 evidence_url 字段",
